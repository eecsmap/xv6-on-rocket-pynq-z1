diff --git a/kernel/memlayout.h b/kernel/memlayout.h
index 4f026ed..99966f7 100644
--- a/kernel/memlayout.h
+++ b/kernel/memlayout.h
@@ -25,9 +25,18 @@
 #define VIRTIO0     0x10001000
 #define VIRTIO0_IRQ 1
 
+// Rocket port: testchipip block device controller (testchipip
+// BlockDevice.scala, HasPeripheryBlockDevice). Used instead of virtio.
+#define BLKDEV0     0x10015000L
+
 // core-local interrupt controller (CLINT)
 #define CLINT_BASE  0x02000000L
 #define CLINT(hart) (CLINT_BASE + (hart) * 4)
+// Rocket port: machine-mode timer registers. This core predates Sstc, so it
+// has no stimecmp; timer interrupts are driven from the CLINT in M-mode and
+// forwarded to supervisor mode as software interrupts (see timervec).
+#define CLINT_MTIMECMP(hartid) (CLINT_BASE + 0x4000 + 8 * (hartid))
+#define CLINT_MTIME (CLINT_BASE + 0xBFF8) // cycles since boot
 
 // qemu puts platform-level interrupt controller (PLIC) here.
 #define PLIC                 0x0c000000L
@@ -41,6 +50,14 @@
 // for use by the kernel and user pages
 // from physical address 0x80000000 to PHYSTOP.
 #define KERNBASE 0x80000000L
+// Upstream's 128MB. Rocket's window is 0x80000000-0x8FFFFFFF (256MB of Zynq
+// DDR), and Linux is confined to the low 256MB, so this is safe -- and
+// usertests' sbrkmuch eagerly grows a process to 100MB, so it is also the
+// minimum that passes the test suite.
+//
+// Note this is only affordable because kfree() skips its debug memset while
+// kinit() builds the free list; see kalloc.c. Poisoning 128MB at boot on this
+// SoC takes 27 seconds.
 #define PHYSTOP  (KERNBASE + 128 * 1024 * 1024)
 
 // map the trampoline page to the highest address,
diff --git a/kernel/proc.c b/kernel/proc.c
index f4c1668..5a8f21e 100644
--- a/kernel/proc.c
+++ b/kernel/proc.c
@@ -463,8 +463,19 @@ scheduler(void)
       release(&p->lock);
     }
     if (found == 0) {
-      // nothing to run; stop running on this core until an interrupt.
-      asm volatile("wfi");
+      // Rocket port: poll the HTIF console here instead of sleeping.
+      //
+      // HTIF has no interrupt line, so console input must be polled. Doing
+      // that only from the timer tick caps input at one character per tick,
+      // which is unusably slow on this board. Polling from the idle path
+      // bounds input by how fast fesvr answers instead, and costs almost
+      // nothing: while a read request is already outstanding, htif_getc()
+      // just reads the `fromhost` global out of local DRAM and generates no
+      // HTIF traffic at all.
+      //
+      // Deliberately no wfi() here -- waiting for an interrupt would put us
+      // straight back to one character per timer tick.
+      uartintr();
     }
   }
 }
diff --git a/kernel/riscv.h b/kernel/riscv.h
index 3e982ab..2df7c91 100644
--- a/kernel/riscv.h
+++ b/kernel/riscv.h
@@ -15,6 +15,7 @@ r_mhartid()
 #define MSTATUS_MPP_M    (3L << 11)
 #define MSTATUS_MPP_S    (1L << 11)
 #define MSTATUS_MPP_U    (0L << 11)
+#define MSTATUS_MIE      (1L << 3)  // machine-mode interrupt enable.
 
 static inline uint64
 r_mstatus()
@@ -98,6 +99,7 @@ w_sip(uint64 x)
 // Supervisor Interrupt Enable
 #define SIE_SEIE (1L << 9) // external
 #define SIE_STIE (1L << 5) // timer
+#define SIE_SSIE (1L << 1) // software
 static inline uint64
 r_sie()
 {
@@ -114,6 +116,7 @@ w_sie(uint64 x)
 
 // Machine-mode Interrupt Enable
 #define MIE_STIE (1L << 5) // supervisor timer
+#define MIE_MTIE (1L << 7) // machine timer
 static inline uint64
 r_mie()
 {
@@ -384,6 +387,21 @@ icache_fence()
 typedef uint64 pte_t;
 typedef uint64 *pagetable_t; // 512 PTEs
 
+
+// Rocket port: machine-mode trap vector and scratch, used by the CLINT
+// timer path in start.c / kernelvec.S (this core has no Sstc).
+static inline void
+w_mtvec(uint64 x)
+{
+  asm volatile("csrw mtvec, %0" : : "r"(x));
+}
+
+static inline void
+w_mscratch(uint64 x)
+{
+  asm volatile("csrw mscratch, %0" : : "r"(x));
+}
+
 #endif // __ASSEMBLER__
 
 #define PGSIZE  4096 // bytes per page
@@ -397,6 +415,17 @@ typedef uint64 *pagetable_t; // 512 PTEs
 #define PTE_W (1L << 2)
 #define PTE_X (1L << 3)
 #define PTE_U (1L << 4) // user can access
+#define PTE_A (1L << 6) // accessed
+#define PTE_D (1L << 7) // dirty
+
+// Rocket port: this core's PTW does NOT update A/D in hardware -- see
+// rocket-chip PTW.scala, where a PTE only counts as a leaf if A is set
+// (`leaf() = v && (r || (x && !w)) && a`) and a store additionally needs D
+// (`sw() = leaf() && w && d`). Upstream papers over this by setting
+// MENVCFG_ADUE, but this core has no menvcfg CSR. Since xv6 has no A/D
+// fault handler, every PTE is created with A and D already set. Setting D on
+// a non-writable page is harmless: D is only consulted once W has passed.
+#define PTE_AD (PTE_A | PTE_D)
 
 // shift a physical address to the right place for a PTE.
 #define PA2PTE(pa) ((((uint64)pa) >> 12) << 10)
diff --git a/kernel/start.c b/kernel/start.c
index 62cce19..9a84c81 100644
--- a/kernel/start.c
+++ b/kernel/start.c
@@ -10,6 +10,12 @@ void timerinit();
